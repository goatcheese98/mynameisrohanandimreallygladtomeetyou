{
  "name": "intro-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.ts --outDir .prerender && node .prerender/prerender.js",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint --flag unstable_native_nodejs_ts_config \"src/*.svelte\" \"src/*.ts\" scripts tests \"playwright*.config.ts\" eslint.config.ts && npm run format:check",
    "test": "playwright test",
    "format:check": "prettier --check \"src/*.svelte\" src/app.css \"src/*.ts\" scripts tests \"playwright*.config.ts\" tsconfig.json package.json .prettierrc.json docs README.md .github/workflows/*.yml wrangler.jsonc eslint.config.ts",
    "build:verify": "node scripts/verify-build.ts",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-dry-run",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 4173 --show-interactive-dev-session=false",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "24.10.0",
    "eslint": "9.39.0",
    "eslint-plugin-svelte": "3.12.4",
    "gh-pages": "^6.3.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.55.7",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "^7.1.7",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "@fontsource/geist": "5.2.6",
    "@fontsource/geist-mono": "5.2.6"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0"
}
