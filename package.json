{
  "name": "intro-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.ts --outDir .prerender && node .prerender/prerender.js",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check src/App.svelte src/app.css \"src/*.ts\" tests playwright.config.ts tsconfig.json package.json .prettierrc.json docs README.md .github/workflows/quality.yml",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "24.10.0",
    "gh-pages": "^6.3.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "^5.39.6",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@fontsource/geist": "5.2.6",
    "@fontsource/geist-mono": "5.2.6",
    "gsap": "^3.13.0"
  }
}
